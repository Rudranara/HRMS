# Use UTF-8 encoding
AddDefaultCharset UTF-8

# Turn on URL rewriting
RewriteEngine On

# ==================================================
# HIDE .php IN BROWSER URL
# Example: /dashboard.php -> /dashboard
# ==================================================
RewriteCond %{THE_REQUEST} \s/+[^\s?]+\.php(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.php$ $1 [R=301,L,NC]

# ==================================================
# LOAD PHP INTERNALLY (INVISIBLE)
# Example: /dashboard → dashboard.php
# ==================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# ==================================================
# Redirect to HTTPS (if SSL is enabled)
# ==================================================
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ==================================================
# Remove "www"
# ==================================================
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]

# ==================================================
# Rewrite "pretty" URLs (your existing router)
# ==================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ error.php?url=$1 [L,QSA]

# Disable directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "(^\.htaccess|\.env|config\.php|db\.php)">
    Require all denied
</FilesMatch>

# Cache control (adjust expiry for performance)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
</IfModule>

# Compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

